# Copy to .env.local and fill in to enable live features.
# Everything here is OPTIONAL — the app works fully without any of it, using a
# dated market snapshot and local (browser) storage for signups.

# Absolute site URL, used for Open Graph / social share image URLs.
# Example: https://gta-6.vercel.app   (no trailing slash)
VITE_SITE_URL=

# JSON endpoint returning a live TTWO quote:
#   { "price": 243.91, "changePct": 0.5, "updatedAt": "2026-07-17T14:00:00Z" }
# Default (/api/quote) is the bundled Vercel function — a keyless quote proxy
# that edge-caches for 5 minutes. When it responds, the UI shows a LIVE badge;
# on any failure it shows "Snapshot · <date>" and uses the built-in values.
VITE_QUOTE_ENDPOINT=/api/quote

# POST endpoint that receives signups as JSON: { email, alerts, ts }
# Default (/api/subscribe) is the bundled Vercel function, which VALIDATES and
# then FORWARDS to the webhook below. Without the webhook, signups still persist
# in the visitor's browser only.
VITE_SUBSCRIBE_ENDPOINT=/api/subscribe

# ── Server-side only (set in Vercel → Environment Variables, NOT prefixed VITE_) ──
# Webhook that /api/subscribe forwards signups to. Any JSON-accepting endpoint:
# a Formspree form URL, Zapier/Make hook, Buttondown, or your own service.
# THIS is what makes the email list durable — without it you collect nothing.
SUBSCRIBE_FORWARD_URL=

# Privacy-friendly analytics (Plausible by default). Leave blank to disable
# entirely — no analytics script loads and no external calls are made.
VITE_ANALYTICS_DOMAIN=
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
