# Committed defaults (safe, non-secret). Override locally in .env.local (gitignored).
# Empty VITE_SITE_URL makes Open Graph URLs resolve to a relative /og-image.png,
# which works on same-origin hosts. Set it to your absolute URL (e.g.
# https://gta-6.vercel.app) for fully-qualified share links on X/Facebook.
VITE_SITE_URL=
