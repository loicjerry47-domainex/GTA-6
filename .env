# Committed defaults (safe, non-secret). Override locally in .env.local (gitignored).
#
# VITE_SITE_URL must be an ABSOLUTE URL (Vite treats it as external so it is not
# bundled, and social/canonical tags need absolute URLs anyway). Change this to
# your real deployed domain, then also re-run the content generator with the same
# value so the static guide/legal pages match:
#   SITE_URL="https://your-domain" node scripts/gen-content.mjs
VITE_SITE_URL=https://gta6.wxza.net

# Same-origin serverless functions (see /api). They only exist on Vercel — in
# local dev/preview the fetches fail silently and the UI falls back to the
# labeled snapshot / browser-storage behavior, which is the designed degradation.
VITE_QUOTE_ENDPOINT=/api/quote
VITE_SUBSCRIBE_ENDPOINT=/api/subscribe
